{
  "info": {
    "_postman_id": "33b7a068-10bf-4b3c-8ef6-209ad6ff8a49",
    "name": "CheckMail Backend API",
    "description": "End-to-end tests for the GCP API Gateway /token and /process routes. Run folders in order because the authentication request stores jwtToken in the selected environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.environment.get('baseUrl');",
          "const apiKey = pm.environment.get('apiKey');",
          "if (!baseUrl) { throw new Error('Set baseUrl in the selected Postman environment.'); }",
          "if (!apiKey) { throw new Error('Set apiKey in the selected Postman environment.'); }",
          "pm.collectionVariables.set('gatewayUrl', String(baseUrl).replace(/\\/+$/, ''));",
          "pm.variables.unset('expectedResult');",
          "pm.variables.unset('expectedComment');",
          "pm.variables.unset('expectedError');",
          "pm.variables.unset('expectedStatuses');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedStatuses = JSON.parse(pm.variables.get('expectedStatuses') || '[200]');",
          "pm.test(`status is one of ${expectedStatuses.join(', ')}`, () => {",
          "  pm.expect(expectedStatuses).to.include(pm.response.code);",
          "});",
          "const maxResponseTimeMs = Number(pm.environment.get('maxResponseTimeMs') || 10000);",
          "pm.test(`response time is below ${maxResponseTimeMs} ms`, () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
          "});",
          "const expectedResult = pm.variables.get('expectedResult');",
          "const expectedComment = pm.variables.get('expectedComment');",
          "const expectedError = pm.variables.get('expectedError');",
          "if (expectedResult || expectedError) {",
          "  let payload;",
          "  pm.test('response body is valid JSON', () => { payload = pm.response.json(); });",
          "  if (expectedResult) {",
          "    pm.test('response matches ProcessEmailResponse', () => {",
          "      payload = payload || pm.response.json();",
          "      pm.expect(Object.keys(payload).sort()).to.deep.equal(['comment', 'result']);",
          "      pm.expect(payload.result).to.equal(expectedResult);",
          "      pm.expect(payload.comment).to.be.a('string').and.not.empty;",
          "      pm.expect(payload.comment).not.to.match(/https?:\\/\\//i);",
          "      if (expectedComment) pm.expect(payload.comment).to.equal(expectedComment);",
          "    });",
          "  }",
          "  if (expectedError) {",
          "    pm.test('response matches ProcessEmailErrorResponse', () => {",
          "      payload = payload || pm.response.json();",
          "      pm.expect(payload).to.deep.equal({ error: expectedError });",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Authentication",
      "description": "Run this folder first. The successful response stores jwtToken in the selected environment.",
      "item": [
        {
          "name": "Issue JWT token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.variables.set('expectedStatuses', '[200]');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "pm.test('token response has the required contract', () => {",
                  "  pm.expect(payload.tokenType).to.equal('Bearer');",
                  "  pm.expect(payload.subject).to.equal(pm.environment.get('subject'));",
                  "  pm.expect(payload.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(payload.token.split('.')).to.have.lengthOf(3);",
                  "  pm.expect(payload.expiresAt).to.be.above(payload.issuedAt);",
                  "});",
                  "pm.environment.set('jwtToken', payload.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"{{subject}}\",\n  \"expiresIn\": \"1h\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/token?key={{apiKey}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["token"],
              "query": [
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
              ]
            }
          }
        }
      ]
    },
