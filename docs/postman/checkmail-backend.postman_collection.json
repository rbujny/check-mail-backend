    {
      "name": "04 Rate limiting (manual runner)",
      "description": "Run this folder with at least 65 rapid iterations after obtaining a JWT. The test accepts normal responses until API Gateway starts returning 429.",
      "item": [
        {
          "name": "Process quota probe",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.info.iteration === 0) pm.environment.unset('processQuota429Seen');",
                  "pm.variables.set('expectedStatuses', '[200,429]');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 429) pm.environment.set('processQuota429Seen', 'true');",
                  "if (pm.info.iterationCount >= 60 && pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('at least one request was rate limited', () => {",
                  "    pm.expect(pm.environment.get('processQuota429Seen')).to.equal('true');",
                  "  });",
                  "  pm.environment.unset('processQuota429Seen');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headers\": { \"from\": \"sender@example.com\" },\n  \"receivedChain\": [\"from mail.example.com by mx.example.net\"],\n  \"securityVerdicts\": { \"spf\": \"pass\", \"dkim\": \"pass\", \"dmarc\": \"pass\" },\n  \"body\": \"Quota probe\",\n  \"truncated\": false,\n  \"links\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/process?key={{apiKey}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["process"],
              "query": [{ "key": "key", "value": "{{apiKey}}" }]
            }
          }
        }
      ]
