openapi: 3.0.4
info:
  title: CheckMail Backend API Gateway
  version: 1.4.0
  description: API Gateway routing, JWT authentication, and quota contract.
x-google-api-management:
  metrics:
    token-requests:
      displayName: Token requests
    process-requests:
      displayName: Process requests
  quota:
    limits:
      token-requests-limit:
        metric: token-requests
        values: ${token_rate_limit_per_minute}
      process-requests-limit:
        metric: process-requests
        values: ${process_rate_limit_per_minute}
  backends:
    auth_backend:
      address: ${auth_backend_url}
      jwtAudience: ${auth_backend_url}
      protocol: "http/1.1"
      pathTranslation: CONSTANT_ADDRESS
    process_backend:
      address: ${process_backend_url}
      deadline: 55.0
      jwtAudience: ${process_backend_url}
      protocol: "http/1.1"
      pathTranslation: CONSTANT_ADDRESS
paths:
  /token:
    post:
      summary: Issue a JWT access token
      operationId: issueToken
      security:
        - ApiKey: []
      x-google-backend: auth_backend
      x-google-quota:
        token-requests: 1
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TokenRequest"
      responses:
        "200":
          description: JWT issued successfully.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/TokenResponse"
        "400":
          description: Invalid token request.
        "429":
          description: Token request rate limit exceeded.
  /process:
    post:
      summary: Process an email for phishing analysis
      description: Run the cost-aware heuristic, RAG, and LLM phishing-analysis pipeline.
      operationId: processEmail
      security:
        - ApiKey: []
          JwtAuth: []
      x-google-backend: process_backend
      x-google-quota:
        process-requests: 1
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProcessedEmailData"
      responses:
        "200":
          description: Email processed successfully.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProcessEmailResponse"
        "400":
          description: Invalid JSON payload or schema validation error.
        "401":
          description: Missing or invalid JWT.
        "429":
          description: Processing request rate limit exceeded.
        "503":
          description: The LLM or RAG dependency is temporarily unavailable.
components:
  securitySchemes:
    ApiKey:
      type: apiKey
      name: key
      in: query
    JwtAuth:
      type: oauth2
      flows:
        implicit:
          authorizationUrl: ""
          scopes: {}
      x-google-auth:
        issuer: ${jwt_issuer}
        jwksUri: ${jwt_jwks_uri}
        audiences:
          - ${jwt_audience}
        jwtLocations:
          - header: Authorization
            valuePrefix: "Bearer "
  schemas:
    TokenRequest:
      type: object
      required: [subject]
      properties:
        subject:
          type: string
        expiresIn:
          oneOf:
            - type: integer
              minimum: 1
            - type: string
      additionalProperties: false
    TokenResponse:
      type: object
      required: [audience, expiresAt, issuedAt, issuer, subject, token, tokenType]
      properties:
        audience:
          type: string
        expiresAt:
          type: integer
          format: int64
        issuedAt:
          type: integer
          format: int64
        issuer:
          type: string
        subject:
          type: string
        token:
          type: string
        tokenType:
          type: string
          enum: [Bearer]
    ProcessedEmailHeaders:
      type: object
      properties:
        from:
          type: string
        to:
          type: string
        subject:
          type: string
        reply-to:
          type: string
        return-path:
          type: string
      additionalProperties: false
    SecurityVerdicts:
      type: object
      properties:
        spf:
          type: string
          enum: [pass, fail, softfail, none]
        dkim:
          type: string
          enum: [pass, fail, none]
        dmarc:
          type: string
          enum: [pass, fail, none]
      additionalProperties: false
    ProcessedEmailData:
      type: object
      required: [headers, receivedChain, securityVerdicts, body, truncated, links]
      properties:
        headers:
          $ref: "#/components/schemas/ProcessedEmailHeaders"
        receivedChain:
          type: array
          items:
            type: string
        securityVerdicts:
          $ref: "#/components/schemas/SecurityVerdicts"
        body:
          type: string
          maxLength: 1000
        truncated:
          type: boolean
        links:
          type: array
          maxItems: 50
          items:
            type: string
            maxLength: 2048
        model:
          type: string
          description: Optional allowlisted runtime model; omit it to use the deployment default.
          enum: [gemini-3.5-flash-lite, gemini-3.7-flash]
      additionalProperties: false
    ProcessEmailResponse:
      type: object
      required: [result, comment]
      properties:
        result:
          type: string
          enum: [OK, WARNING, PHISHING]
        comment:
          type: string
